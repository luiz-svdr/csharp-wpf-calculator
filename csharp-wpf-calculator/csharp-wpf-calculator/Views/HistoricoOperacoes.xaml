<Window x:Class="csharp_wpf_calculator.Views.HistoricoOperacoes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:csharp_wpf_calculator.Views"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Histórico" Height="410" Width="350" Background="Gray">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="RetornoBtn" Grid.Row="0"
                Style="{StaticResource BtnRetornoStyle}"
                Click="ReturnBtn_Click"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Grid.Row="0" Text="Histórico" FontSize="20" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoricoListControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="5" Margin="0,5,0,5" Padding="10">
                            <TextBlock Text="{Binding Descricao}" Foreground="Black" FontWeight="SemiBold" FontSize="14"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>